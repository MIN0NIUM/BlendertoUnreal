            "string",
            "null"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "useDeform": {
          "type": "boolean",
          "default": true
        },
        "isLeaf": {
          "type": "boolean",
          "description": "子を持たないボーン。**FBX は関節の位置しか持たないため、末端ボーンの長さは往復で保存されない**（実測: 0.25m -> 0.35m）。UE 側の検証では isLeaf の lengthCm を比較対象にしてはいけない"
        },
        "lengthCm": {
          "type": "number",
          "minimum": 0
        },
        "headCm": {
          "$ref": "#/$defs/vec3"
        },
        "tailCm": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/vec3",
          "description": "rest 姿勢のオイラー角 (度)。**要検証**: UE 側の実測が未了"
        }
      }
    },
    "skinStats": {
      "description": "スキンウェイトの実測。V-068 / V-069 / V-070 / V-071 の根拠",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vertexCount": {
          "type": "integer",
          "minimum": 0
        },
        "unassignedVertexCount": {
          "type": "integer",
