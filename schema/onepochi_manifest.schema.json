        },
        "worstWeightTotal": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxWeightDeviation": {
          "type": "number",
          "minimum": 0
        },
        "maxInfluencesPerVertex": {
          "type": "integer",
          "minimum": 0
        },
        "bonesWithoutWeight": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
