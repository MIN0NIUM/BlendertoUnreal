{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git init*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(gh pr create*)",
      "Bash(gh release create*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"C:/Users/user/Documents/_STUDY/BlenderToUnreal/.claude/hooks/block-git-write.sh\"",
            "timeout": 10,
            "statusMessage": "Git 操作の禁止チェック"
          }
        ]
      }
    ]
  }
}
